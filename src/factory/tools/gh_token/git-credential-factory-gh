#!/bin/sh
# git-credential-factory-gh — git credential helper backed by the factory-gh
# token dispenser Unix socket (#1078).
#
# Git protocol: invoked as `git credential-factory-gh <action>` where action ∈
# {get, store, erase}. We support 'get' only — token storage/erase is a no-op
# because tokens are minted on demand and live only in tmpfs.
#
# Spawned by git as the lyra user (uid 1500). Dispenser socket is mode 0660
# group factory-tokenuser (gid 1502). Both users are in that group, so connect
# succeeds without root.

set -eu

SOCK="${FACTORY_GH_DISPENSER_SOCK:-/run/factory-gh-token/dispenser.sock}"

case "${1:-}" in
  get) ;;
  store|erase) exit 0 ;;
  '') echo "usage: $0 get|store|erase" >&2; exit 2 ;;
  *) echo "unknown action: $1" >&2; exit 2 ;;
esac

# Drain git's stdin (key=value lines + blank). We don't need any of it — the
# dispenser hands us the SAME token regardless of host/path because we are a
# single-purpose helper for the bound GitHub App. Read+discard so git doesn't
# get SIGPIPE on the writer side.
while read -r _line && [ -n "$_line" ]; do :; done

# Talk to the dispenser. Prefer `socat` if available (smaller surface, clearer
# protocol). Fall back to `nc -U` (BSD/openbsd-nc supports -U; Debian's nc6
# does not — error early in that case).
if command -v socat >/dev/null 2>&1; then
  printf 'get\n' | socat -t 2 - "UNIX-CONNECT:${SOCK}"
elif command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
  printf 'get\n' | nc -U -w 2 "${SOCK}"
else
  echo "git-credential-factory-gh: neither socat nor BSD nc -U available" >&2
  exit 1
fi
