[Unit]
Description=Lyra Discord adapter
# After= orders startup; no Requires=/BindsTo= so a hub restart does not
# propagate a stop to the adapter. Adapters reconnect to NATS on their own
# once the hub is back; tearing them down blocks auto-recovery.
After=lyra-hub.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
# Image digest pinning for localhost/lyra:latest tracks on a follow-up issue
# (CI tag-by-SHA strategy).
Image=ghcr.io/roxabi/lyra:staging
Label=io.containers.autoupdate=registry
ContainerName=lyra-discord
Network=roxabi.network
# Hardening — defense in depth (see issue #652).
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
# ADR-054 Decision 2: UserNS=keep-id maps container UID to host UID 1000 (mickael),
# which owns ~/.lyra/*. Replaces User=lyra (UID 1500) which could not read host files.
UserNS=keep-id:uid=1500,gid=1500
# Bot tokens delivered via Podman secrets (superseded by #1057).
# See `## Bot credentials` in docs/CONFIGURATION.md.
Environment=NATS_URL=nats://lyra-nats:4222
# ADR-054 Decision 5 (revised): nkey seed delivered as Podman secret.
Secret=lyra-nats-discord,type=mount,target=lyra-nats-discord.seed,uid=1500,gid=1500,mode=0400
Environment=NATS_NKEY_SEED_PATH=/run/secrets/lyra-nats-discord.seed
# Bot tokens are provisioned as Podman secrets — one per bot (and optionally
# one per webhook). Use `lyra bot secret install discord <bot_id>` to provision,
# then `make quadlet-bot-secrets-render` to generate the fragment to paste here.
#
# Each line follows the shape:
#   Secret=lyra-bot-discord-<bot_id>,type=mount,target=bot_token-<bot_id>,mode=0400,uid=1500,gid=1500
#   Secret=lyra-bot-discord-<bot_id>-webhook,type=mount,target=bot_webhook-<bot_id>,mode=0400,uid=1500,gid=1500
#
# --- BEGIN bot secrets (regenerate via `make quadlet-bot-secrets-render`) ---
# Secret=lyra-bot-discord-demo,type=mount,target=bot_token-demo,mode=0400,uid=1500,gid=1500
# --- END bot secrets ---
Volume=lyra-data.volume:/home/lyra/.lyra:z
# Inline single-file bind mount — see rationale in lyra-hub.container.
Volume=%h/.lyra/config.toml:/app/config.toml:ro,z
Exec=lyra adapter discord

[Service]
Restart=on-failure
RestartSec=10
# Cap at 2 full cores — prevents a runaway worker from starving hub + NATS.
CPUQuota=200%

[Install]
WantedBy=default.target
