[Unit]
Description=Factory social media tool satellite (Postiz v1 backing provider)
After=factory-nats.service
Wants=factory-nats.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
StopTimeout=120
Image=ghcr.io/roxabi/factory:staging-svc
Label=io.containers.autoupdate=registry
ContainerName=factory-socialmedia-adapter
Network=roxabi.network
Network=postiz.network
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
UserNS=keep-id:uid=1500,gid=1500
Secret=factory-nats-socialmedia,type=mount,target=factory-nats-socialmedia.seed,uid=1500,gid=1500,mode=0400
Secret=factory-socialmedia-api-key,type=mount,target=socialmedia-api-key,uid=1500,gid=1500,mode=0400
Secret=factory_blobstore_token,type=mount,target=blobstore-token,uid=1500,gid=1500,mode=0400
Environment=NATS_URL=nats://factory-nats:4222
Environment=NATS_NKEY_SEED_PATH=/run/secrets/factory-nats-socialmedia.seed
Environment=SOCIALMEDIA_PROVIDER_BASE_URL=http://postiz-app:5000/api
Environment=SOCIALMEDIA_PROVIDER_API_KEY_PATH=/run/secrets/socialmedia-api-key
Environment=FACTORY_BLOBSTORE_URL=http://factory-blobstore:8080
Environment=FACTORY_BLOBSTORE_TOKEN_PATH=/run/secrets/blobstore-token
Environment=PYTHONUNBUFFERED=1
Exec=factory socialmedia-adapter

[Service]
Restart=on-failure
TimeoutStopSec=130
RestartSec=10

[Install]
WantedBy=default.target