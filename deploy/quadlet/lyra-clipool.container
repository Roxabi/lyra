[Unit]
Description=Lyra CliPool Worker
After=lyra-nats.service
After=lyra-gh-pod.service
# No Requires= on NATS — clipool connects directly; hub restarts must not cascade.
# BindsTo= the pod so clipool is stopped when the pod (and helper) are torn down.
BindsTo=lyra-gh-pod.service
# Rate-limit restarts so a crash-loop cannot spam GitHub /app/installations/{id}/access_tokens
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
Image=ghcr.io/roxabi/lyra:staging
Label=io.containers.autoupdate=registry
ContainerName=lyra-clipool
# Pod= moves network + user namespace ownership to lyra-gh.pod.
# UserNS=keep-id:uid=1500 is now declared on the pod (lyra-gh.pod [Pod] section)
# and shared by both containers. Removed from this unit to avoid conflict.
Pod=lyra-gh.pod
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
# UserNS moved to lyra-gh.pod [Pod] section — do not re-declare here.
# Network= moved to lyra-gh.pod — pod owns the network namespace.
Environment=NATS_URL=nats://lyra-nats:4222
Secret=lyra-nkey-clipool-worker,type=mount,target=clipool-worker.seed,mode=0400,uid=1500,gid=1500
Environment=NATS_NKEY_SEED_PATH=/run/secrets/clipool-worker.seed
# ~/.claude/ — directory mount (not file mounts) so Syncthing's atomic renames
# (unlink old inode → rename new) remain transparent to the container.
# Single-file bind-mounts bind the inode at mount time; after an atomic replace
# the container holds a Links:0 ghost and never sees the refreshed token.
Volume=%h/.claude:/home/lyra/.claude:z
Volume=%h/.claude.json:/home/lyra/.claude.json:z
# Workspace — mirrors host ~/projects so claude subprocess picks up per-project CLAUDE.md
Volume=%h/projects:/home/lyra/projects:z
Environment=LYRA_CLAUDE_CWD=/home/lyra/projects
EnvironmentFile=-%h/.lyra/env/clipool.env

# ── GitHub App identity (#1078) ─────────────────────────────────────────────
# Tmpfs for token cache — identical declaration on both pod containers.
# Podman ≥5.x does NOT support Tmpfs= in [Pod] sections AND does NOT accept
# uid=/gid= in container-level Tmpfs= options. Isolation is enforced at FILE
# level: cache file mode 0600 uid 1501 (I-2), socket mode 0660 gid 1502 (I-3).
# mode=0711 = traversal-only for uid 1500 (cannot ls/cat, can connect socket).
Tmpfs=/run/lyra-gh-token:mode=0711
# Tmpfs for ~/.config/git so the git config template can be sourced read-only;
# the runtime user has GIT_CONFIG_GLOBAL pointing into the image-baked /etc/lyra
# template, so this tmpfs is reserved for any future per-process overrides.
# Note: ReadOnly=true is preserved — only Tmpfs= additions for credentials.
Tmpfs=/home/lyra/.config/git:mode=0755

# PEM secret removed — invariant I-5: PEM mounts only on lyra-gh-helper.container.
# lyra-gh shim (uid 1500) reads tokens via the dispenser socket, never the PEM.

# LYRA_GH_APP_ID / LYRA_GH_INSTALLATION_ID removed — consumed only by the helper
# daemon (lyra-gh-helper.container). Clipool reads tokens via the dispenser socket.

# Wire git's global config to the image-baked template so the credential
# helper line resolves transparently for any `git push` from inside Claude.
Environment=GIT_CONFIG_GLOBAL=/etc/lyra/git.config.tmpl

# χ-2 decision: /proc hidepid=2 is intentionally NOT enabled here. Rationale:
# (a) podman exec introspection (`podman top`, `podman exec ... ps -ef`) is
# valuable for ops; hidepid=2 breaks it for non-procuser members.
# (b) defense-in-depth on token isolation already covers the intended attack
# (token cache 0600/uid 1501; env scoped via `lyra-gh` exec). Revisit if a
# future threat model surfaces /proc/<helper-pid>/environ as a leak vector.
Exec=lyra adapter clipool

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
CPUQuota=400%
ExecStartPre=/bin/bash -c 'test -e %h/.claude.json || echo "{}" > %h/.claude.json'
ExecStartPre=/bin/bash -c 'test -e %h/.claude/.credentials.json || echo "{}" > %h/.claude/.credentials.json'

[Install]
WantedBy=default.target
