# DEPRECATED — host-timer monitoring is superseded by Monitoring v2 (#1035).
# Do not install on new hosts. Existing prod has been disabled. Code retained
# for the v2 spec author to mine; this unit will be deleted when #1035 lands.

[Unit]
Description=[DEPRECATED — see #1035] Lyra health monitor (Layer 1 pre-check + Layer 2 LLM escalation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/lyra
EnvironmentFile=%h/projects/lyra/.env
ExecStart=%h/projects/lyra/.venv/bin/python -m lyra.monitoring
TimeoutStartSec=60

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=%h/.lyra %h/.local/state/lyra
