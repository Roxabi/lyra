[Unit]
Description=Lyra Discord adapter private data bind-mount — discord.db only (#1721).
# Bind-mount of %h/.roxabi/factory-discord — used by the Discord adapter container only.
# Isolates discord.db from the hub-shared factory-data.volume so the Discord container
# no longer mounts the hub's data directory. Host dir created by deploy/install.sh.

[Volume]
Type=none
Device=%h/.roxabi/factory-discord
Options=bind
Label=app=factory
