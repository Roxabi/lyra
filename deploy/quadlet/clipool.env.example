# clipool.env — environment for lyra-clipool container
# Copy to ~/.lyra/env/clipool.env and fill in values

# NATS_URL is set inline in lyra-clipool.container
# NATS_NKEY_SEED_PATH is injected via Podman secret

# Working directory for claude subprocesses — overridden inline in lyra-clipool.container
# LYRA_CLAUDE_CWD=/home/lyra/projects

# LYRA_LOG_LEVEL removed — use [logging] level in config.toml instead

# ── GitHub App identity (#1078) ─────────────────────────────────────────────
# Copy to ~/.lyra/env/clipool.env and set values for this host.
#
# M₁ (roxabituwer) → Lyra-prod App
# M₂ (ROXABITOWER) → Lyra-dev App
#
# Leave empty to disable the gh_token helper (clipool runs without git push
# capability — `git fetch` over SSH still works if you set up SSH keys).

LYRA_GH_APP_ID=
LYRA_GH_INSTALLATION_ID=
