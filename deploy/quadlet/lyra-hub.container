[Unit]
Description=Lyra Hub
After=lyra-nats.service
Requires=lyra-nats.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
# Image digest pinning for localhost/lyra:latest tracks on a follow-up issue
# (CI tag-by-SHA strategy). Upstream registry images (e.g. nats.container)
# are pinned by digest directly.
Image=ghcr.io/roxabi/lyra:staging-svc
Label=io.containers.autoupdate=registry
ContainerName=lyra-hub
Network=roxabi.network
# Hardening — defense in depth (see issue #652).
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
# ADR-054 Decision 2: UserNS=keep-id maps container UID to host UID 1000 (mickael),
# which owns ~/.lyra/*. Replaces User=lyra (UID 1500) which could not read host files.
UserNS=keep-id:uid=1500,gid=1500
# Podman 5.7 treats `-%h/` as a literal path (does not strip `-` before
# specifier expansion), producing a malformed arg. Drop the prefix; rely on
# provision.sh to ensure hub.env exists (see deploy/quadlet/hub.env.example).
EnvironmentFile=%h/.lyra/env/hub.env
# hub.env contains only hub-scoped vars (LYRA_HEALTH_SECRET,
# ROXABI_VAULT_DIR). Adapter tokens (Telegram, Discord, TTS/STT)
# are excluded — hub does not need them. See deploy/quadlet/hub.env.example.
# NATS_URL is overridden inline below; cutover = update .env.hub directly.
Environment=NATS_URL=nats://lyra-nats:4222
# ADR-054 Decision 5 (revised): nkey seed delivered as Podman secret.
Secret=lyra-nats-hub,type=mount,target=lyra-nats-hub.seed,uid=1500,gid=1500,mode=0400
Environment=NATS_NKEY_SEED_PATH=/run/secrets/lyra-nats-hub.seed
Volume=lyra-data.volume:/home/lyra/.lyra:z
# T26 (#1331): hub is now a READER — turns.db must be ro; lyra-turn-writer owns writes.
# Specific bind-mount after the broad lyra-data volume; Podman last-mount-wins on the
# same path, so this ro overlay takes precedence over the rw volume for turns.db alone.
Volume=%h/.lyra/turns.db:/home/lyra/.lyra/turns.db:ro,z
# Inline single-file bind mount — Quadlet .volume units wrapping a single file
# either fail with loop-device errors or are silently downgraded to empty named
# volumes (IsADirectoryError at read time). Inline Volume= does a direct bind.
Volume=%h/.lyra/config.toml:/app/config.toml:ro,z
# Vault DB — hub runs `vault put` as subprocess; vault CLI defaults to ~/.roxabi-vault/vault.db
# which must be bind-mounted so writes reach the host DB. VAULT_DB tells the CLI the container path.
Volume=%h/.roxabi-vault:/home/lyra/.roxabi-vault:z
Environment=VAULT_DB=/home/lyra/.roxabi-vault/vault.db
# ~/.claude/ mounts moved to lyra-clipool.container (issue #941 — security boundary)
# Health endpoint — probed by `python -m lyra.monitoring` via host loopback (localhost:8443).
# Bind to 0.0.0.0 inside container so PublishPort forwarding reaches uvicorn;
# host exposure is restricted to 127.0.0.1 by PublishPort below.
Environment=LYRA_HEALTH_HOST=0.0.0.0
# Cold Qwen3 TTS model load takes ~60s; default 30s fires before model is ready.
Environment=LYRA_TTS_TIMEOUT=90
PublishPort=127.0.0.1:8443:8443
Exec=lyra hub
HealthCmd=grep -q hub /proc/1/cmdline
HealthInterval=30s

[Service]
Restart=on-failure
RestartSec=10
# Cap at 2 full cores — prevents a runaway worker from starving hub + NATS.
CPUQuota=200%
# Pre-create single-file bind-mount sources if absent — prevents Podman from
# auto-creating them as directories (IsADirectoryError at read time).

[Install]
WantedBy=default.target
