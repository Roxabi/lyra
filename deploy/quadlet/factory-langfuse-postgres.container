[Unit]
Description=Factory Langfuse Postgres (trace store metadata)
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
Image=docker.io/postgres:17
ContainerName=factory-langfuse-postgres
Network=roxabi.network
NoNewPrivileges=true
DropCapability=all
EnvironmentFile=%h/.roxabi/factory/env/langfuse.env
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=postgres
Environment=TZ=UTC
Environment=PGTZ=UTC
Volume=factory-langfuse-postgres-data.volume:/var/lib/postgresql/data:z
HealthCmd=pg_isready -U postgres
HealthInterval=10s

[Service]
Restart=on-failure
RestartSec=10
ExecStartPre=/bin/test -r %h/.roxabi/factory/env/langfuse.env

[Install]
WantedBy=default.target