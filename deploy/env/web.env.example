# Copy to ~/.roxabi/factory/env/web.env (chmod 600)
# TAILSCALE_IPV4=$(tailscale ip -4 | head -1)

TAILSCALE_IPV4=

# Operator auth (#1992 phase 2) — when set, BFF /api/bff/connectors/* requires Bearer.
# FACTORY_DASHBOARD_OPERATOR_TOKEN=

# Factory tenant bound to this dashboard instance (ingress installation registry scope).
FACTORY_DASHBOARD_FACTORY_TENANT=default
FACTORY_DASHBOARD_OPERATOR_USER_ID=operator

# GitHub App install URL for dashboard integrations page.
# INGRESS_GITHUB_APP_SLUG=