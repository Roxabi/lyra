#!/usr/bin/env bash
# Appends Lyra-Session-Id and Lyra-Agent trailers to the commit message
# when both env vars are set. Idempotent on git commit --amend via
# `--if-exists doNothing`. No-op when either var is missing.
set -eu
COMMIT_MSG_FILE="${1:?prepare-commit-msg: COMMIT_MSG_FILE not provided}"
if [ -z "${FACTORY_SESSION_ID:-}" ] || [ -z "${FACTORY_AGENT:-}" ]; then
    exit 0
fi
git interpret-trailers --in-place \
    --if-exists doNothing \
    --trailer "Lyra-Session-Id: ${FACTORY_SESSION_ID}" \
    --trailer "Lyra-Agent: ${FACTORY_AGENT}" \
    "$COMMIT_MSG_FILE"
