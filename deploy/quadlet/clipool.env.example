# clipool.env — environment for factory-clipool container
# Copy to ~/.roxabi/factory/env/clipool.env and fill in values

# NATS_URL is set inline in factory-clipool.container
# NATS_NKEY_SEED_PATH is injected via Podman secret

# Working directory for claude subprocesses — overridden inline in factory-clipool.container
# FACTORY_CLAUDE_CWD=/home/factory/projects

# FACTORY_LOG_LEVEL removed — use [logging] level in config.toml instead

# ── OpenTelemetry (defaults inlined in factory-clipool.container) ────────────
# Override endpoint or disable traces by uncommenting:
# CLAUDE_CODE_ENABLE_TELEMETRY=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://factory-otel-collector:4317

# ── GitHub App identity ──────────────────────────────────────────────────────
# FACTORY_GH_APP_ID and FACTORY_GH_INSTALLATION_ID moved to factory-gh-helper.container
# (inlined as Environment= directives, per PR #1078). clipool no longer reads them.
