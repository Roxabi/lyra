# hub.env — hub container environment
# Copy to ~/.roxabi/factory/env/hub.env before starting factory-hub.service.
# chmod 600 ~/.roxabi/factory/env/hub.env
#
# ADR-054: bot tokens are NO LONGER stored here. Since #417 (auth.db split, March 2026),
# tokens live Fernet-encrypted in ~/.roxabi/factory/config.db and are decrypted at runtime via
# ~/.roxabi/factory/keyring.key. This file holds only operational vars for the hub container.
#
# NATS_URL and NATS_NKEY_SEED_PATH are set inline in factory-hub.container.

# FACTORY_LOG_LEVEL removed — use [logging] level in config.toml instead

# Secret token for the /health endpoint (any random string; keep private)
FACTORY_HEALTH_SECRET=

# Health listener port (default 8443; matches PublishPort in factory-hub.container)
FACTORY_HEALTH_PORT=8443

# Typing-indicator NATS plane (#1376) — set to true to enable lyra.typing.* publish.
# IMPORTANT: flipping this to true ALSO requires updating the adapter Quadlet
# templates (`deploy/quadlet/factory-{telegram,discord}.container.tmpl`) where the
# adapter-side flag lives as inline `Environment=` — otherwise the typing plane
# is split-brain (hub publishes, adapters never subscribe). See #1389 review.
FACTORY_TYPING_ENABLED=false

# BlobStore client — read by init_blobstore() at hub startup (restart-not-HUP).
# If FACTORY_BLOBSTORE_TOKEN_PATH is absent, blob_store degrades to None (audio attachments
# disabled, warning logged; no crash).
#FACTORY_BLOBSTORE_URL=http://localhost:8449
#FACTORY_BLOBSTORE_TOKEN_PATH=~/.roxabi/factory/blobstore.tok
