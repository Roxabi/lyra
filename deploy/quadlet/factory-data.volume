[Unit]
Description=Factory data bind-mount — Hub (RW: auth.db, config.db, keyring.key). TurnWriter sole writer of turns.db under turn-writer/ (ADR-075); hub reads via NATS (#2309).
# Bind-mount of %h/.roxabi/factory — used by the Hub container only (#943).
# Adapters read bot roster from factory-state KV (#1946); per-file inline bind mounts
# (keyring.key, turns.db, discord.db) minimise blast radius on adapter compromise.
# Rationale: ADR-054 Decision 1 — tokens live in config.db since #417 (auth.db split);
# named volume approach (ADR-053) left host files unexposed, causing credential lookup failure.

[Volume]
Type=none
Device=%h/.roxabi/factory
Options=bind
Label=app=factory
