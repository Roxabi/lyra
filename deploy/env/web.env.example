# Copy to ~/.roxabi/factory/env/web.env (chmod 600)
# TAILSCALE_IPV4=$(tailscale ip -4 | head -1)

TAILSCALE_IPV4=

# --- ADR-103 control-plane auth (Python BFF) ---
# Bootstrap first admin once (idempotent if an admin already exists):
# FACTORY_DASHBOARD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# FACTORY_DASHBOARD_BOOTSTRAP_ADMIN_PASSWORD=  # empty → one-time generated (logged)
#
# Local HTTP without Secure cookies (dev only — never in prod):
# FACTORY_DASHBOARD_COOKIE_INSECURE=1
#
# E2E / smoke only (never enable in production):
# FACTORY_DASHBOARD_E2E=0
#
# Optional shared API key (legacy connectors path; prefer user API keys):
# FACTORY_DASHBOARD_OPERATOR_TOKEN=

# Factory tenant bound to this dashboard instance (ingress installation registry scope).
FACTORY_DASHBOARD_FACTORY_TENANT=default
FACTORY_DASHBOARD_OPERATOR_USER_ID=operator

# GitHub App install URL for dashboard integrations page.
# INGRESS_GITHUB_APP_SLUG=
