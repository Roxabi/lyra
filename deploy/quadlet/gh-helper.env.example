# gh-helper.env — environment for lyra-gh-helper container (token-mint daemon)
# Copy to ~/.lyra/env/gh-helper.env and fill in values for this host.
#
# M₁ (roxabituwer) → Lyra-prod GitHub App
# M₂ (ROXABITOWER) → Lyra-dev GitHub App
#
# Leave LYRA_GH_APP_ID empty to disable the helper at startup.
# clipool will still run but `git push` via lyra-gh shim will fail.
#
# LYRA_GH_PEM_PATH is set inline in lyra-gh-helper.container — do not override here.

LYRA_GH_APP_ID=
LYRA_GH_INSTALLATION_ID=
