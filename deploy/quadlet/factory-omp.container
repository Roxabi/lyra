[Unit]
Description=Factory OmpWorker — omp_rpc NATS runtime backend (#1812)
After=factory-nats.service

[Container]
# Agent-runtime image — carries the factory CLI plus /opt/omp/omp baked from the
# factory-omp-base carrier (Dockerfile COPY --from). The carrier itself is FROM
# scratch and can never exec `factory adapter omp` (#1867).
Image=ghcr.io/roxabi/factory:staging
ContainerName=factory-omp
Exec=factory adapter omp
UserNS=keep-id:uid=1500,gid=1500
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
Network=roxabi.network
Environment=NATS_URL=nats://factory-nats:4222
Secret=factory-nats-omp,type=mount,target=factory-nats-omp.seed,uid=1500,gid=1500,mode=0400
Environment=NATS_NKEY_SEED_PATH=/run/secrets/factory-nats-omp.seed
Secret=factory-litellm-key,type=mount,target=factory-litellm-key.tok,uid=1500,gid=1500,mode=0400
Environment=LITELLM_API_KEY_FILE=/run/secrets/factory-litellm-key.tok
Tmpfs=/tmp
# omp mkdir's $HOME/.omp at boot for its file-log transport (makeFileTransport);
# ReadOnly=true makes that EROFS without a writable mount (#1877). Ephemeral is
# correct — no_session=True means no session state to persist; logs go to journald.
Tmpfs=/home/factory/.omp:mode=0755
Volume=%h/projects/roxabi-factory/deploy/omp:/home/factory/.config/omp-pi:ro,Z
Environment=PI_CODING_AGENT_DIR=/home/factory/.config/omp-pi
# Workspace — mirrors host ~/projects so the git ownership probe finds its target
# (run_git_ownership_probe defaults to /home/factory/projects/roxabi-factory).
# Same mount as factory-clipool; UserNS=keep-id:uid=1500,gid=1500 ensures correct ownership.
Volume=%h/projects:/home/factory/projects:z
Label=io.containers.autoupdate=registry

[Service]
Restart=on-failure
RestartSec=10
TimeoutStopSec=120

[Install]
WantedBy=default.target
