# Langfuse stack env — copy to ~/.roxabi/factory/env/langfuse.env
# Prefer: bash deploy/scripts/bootstrap-langfuse.sh (generates secrets + otel-collector.env)

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@factory-langfuse-postgres:5432/postgres
POSTGRES_PASSWORD=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
TELEMETRY_ENABLED=false
CLICKHOUSE_MIGRATION_URL=clickhouse://factory-langfuse-clickhouse:9000
CLICKHOUSE_URL=http://factory-langfuse-clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_HOST=factory-langfuse-redis
REDIS_PORT=6379
REDIS_AUTH=CHANGEME
REDISCLI_AUTH=CHANGEME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://factory-langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_INIT_ORG_ID=factory
LANGFUSE_INIT_PROJECT_ID=factory-traces
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@factory.local
LANGFUSE_INIT_USER_PASSWORD=CHANGEME