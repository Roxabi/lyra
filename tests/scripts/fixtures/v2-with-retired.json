{
  "version": "2",
  "request_reply_flows": [
    { "requester": "hub", "responder": "clipool-worker", "subject": "factory.jobs.claude" }
  ],
  "identities": {
    "hub": {
      "status": "active",
      "created_at": "2026-04-21",
      "owner": "factory",
      "description": "Hub core — routes inbound messages, dispatches to voice/LLM/image/clipool workers.",
      "allow_responses": false,
      "publish": [
        "factory.outbound.telegram.>",
        "factory.outbound.discord.>",
        "factory.voice.tts.request.>",
        "factory.voice.stt.request.>",
        "factory.llm.generate.request",
        "factory.image.generate.request",
        "factory.jobs.claude",
        "factory.clipool.control",
        "factory.audit.>",
        "$JS.API.>",
        "$KV.factory-state.>"
      ],
      "subscribe": [
        "factory.inbound.telegram.>",
        "factory.inbound.discord.>",
        "factory.voice.tts.heartbeat",
        "factory.voice.stt.heartbeat",
        "factory.llm.heartbeat",
        "factory.system.ready",
        "factory.image.heartbeat",
        "factory.clipool.heartbeat",
        "_inbox.hub.>"
      ]
    },
    "voice-tts": {
      "status": "active",
      "created_at": "2026-04-21",
      "owner": "voicecli",
      "description": "voicecli nats-serve TTS worker.",
      "allow_responses": true,
      "publish": [
        "factory.voice.tts.heartbeat",
        "factory.system.ready"
      ],
      "subscribe": [
        "factory.voice.tts.request",
        "factory.voice.tts.request.>",
        "_inbox.voice-tts.>"
      ]
    },
    "clipool-worker": {
      "status": "active",
      "created_at": "2026-04-27",
      "owner": "factory",
      "description": "CliPool NATS worker — receives claude subprocess dispatch commands from hub.",
      "allow_responses": true,
      "publish": [
        "factory.clipool.heartbeat",
        "factory.system.ready",
        "$JS.API.>"
      ],
      "subscribe": [
        "factory.jobs.claude",
        "factory.clipool.control",
        "_inbox.clipool-worker.>",
        "$KV.factory-state.>"
      ]
    },
    "old-worker": {
      "status": "retired",
      "created_at": "2025-01-01",
      "retired_at": "2025-06-01",
      "owner": "reserved",
      "description": "Legacy worker — retired, no longer active.",
      "allow_responses": false,
      "publish": [
        "factory.old.heartbeat"
      ],
      "subscribe": [
        "factory.old.cmd"
      ]
    }
  }
}
