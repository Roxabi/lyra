# ┌──────────────────────────────────────────────────────────────────────────┐
# │  Factory .env — environment variables for local dev / deploy tooling    │
# │                                                                        │
# │  Bot tokens (Telegram, Discord) are NOT stored here. Use:               │
# │    factory bot add / factory bot secret install telegram lyra           │
# │  Tokens live encrypted in ~/.roxabi/factory/config.db.                  │
# └──────────────────────────────────────────────────────────────────────────┘

# --- Voice & Audio (dev: factory start loads these via python-dotenv) ---
# FACTORY_STT_MODEL=large-v3-turbo         # faster-whisper model: tiny | small | medium | large-v3-turbo
# FACTORY_AUDIO_TMP=                       # custom tmp dir for audio files (must be writable)
# FACTORY_MAX_AUDIO_BYTES=5242880          # max audio upload size (default: 5 MB)

# --- Health endpoint (dev unified mode; prod uses ~/.roxabi/factory/env/hub.env) ---
# FACTORY_HEALTH_SECRET=                   # bearer token for /health endpoint (leave empty to disable auth)

# --- Deployment target — used by `make remote`, `make push` (from dev machine → M₁) ---
DEPLOY_HOST=                            # SSH user@host for production hub (e.g. user@192.168.1.16)
DEPLOY_DIR=~/projects/roxabi-factory    # project path on the production host

# --- Paths (all optional, sensible defaults) ---
# FACTORY_CONFIG=config.toml              # path to config.toml (default: config.toml in cwd)
# FACTORY_MESSAGES_CONFIG=                 # path to custom messages.toml
# ROXABI_FACTORY_DIR=                      # factory data dir (default: ~/.roxabi/factory)
# FACTORY_LOG_DIR=                         # log output dir (default: ~/.local/state/factory/logs)
# --- NATS (standalone hub/adapter mode) ---
# NATS_URL=nats://localhost:4222          # NATS server URL (required for standalone + cortex-memory)
# Knowledge capture/search: CortexVault → roxabi.memory.* (requires cortex-memory serve)

# --- NATS authentication (production only) ---
# NATS_NKEY_SEED_PATH=/etc/nats/nkeys/hub.seed   # path to nkey seed file (unset = no auth, for local dev)
# NATS_CA_CERT=/etc/nats/certs/ca.crt             # CA cert for TLS (unset = plain TCP, for local dev)
