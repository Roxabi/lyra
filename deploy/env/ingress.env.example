# Copy to ~/.roxabi/factory/env/ingress.env (chmod 600)
# TAILSCALE_IPV4=$(tailscale ip -4 | head -1)

TAILSCALE_IPV4=
NATS_URL=nats://factory-nats:4222
FACTORY_INGRESS_CONFIG=/home/factory/.roxabi/factory/ingress.toml
INGRESS_GITHUB_WEBHOOK_SECRET_PATH=/run/secrets/ingress-github-webhook
INGRESS_CLOUDFLARE_WEBHOOK_SECRET_PATH=/run/secrets/ingress-cloudflare-webhook