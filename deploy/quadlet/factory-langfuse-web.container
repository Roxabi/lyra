[Unit]
Description=Factory Langfuse web UI + OTLP ingest (ADR-092)
After=factory-langfuse-postgres.service factory-langfuse-clickhouse.service factory-langfuse-redis.service factory-langfuse-minio.service factory-langfuse-worker.service
Wants=factory-langfuse-postgres.service factory-langfuse-clickhouse.service factory-langfuse-redis.service factory-langfuse-minio.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
Image=docker.io/langfuse/langfuse:3
ContainerName=factory-langfuse-web
Network=roxabi.network
NoNewPrivileges=true
ReadOnly=true
DropCapability=all
EnvironmentFile=%h/.roxabi/factory/env/langfuse.env
PublishPort=127.0.0.1:3000:3000
HealthCmd=wget -q -O- http://factory-langfuse-web:3000/api/public/health || exit 1
HealthInterval=30s

[Service]
Restart=on-failure
RestartSec=15
ExecStartPre=/bin/test -r %h/.roxabi/factory/env/langfuse.env

[Install]
WantedBy=default.target